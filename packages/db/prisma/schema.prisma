// ---------------------------------------------------------------------------
// Local store — the source of truth. The spreadsheet is a publication target,
// not the database: rows only leave here on an explicit, reviewed push.
//
// SQLite by default so logging hours never depends on Docker being up. To share
// lp-internal-ai-v1's Postgres instead, change provider to "postgresql", point
// DATABASE_URL at it, and re-run `pnpm db:push` — no model changes needed.
// ---------------------------------------------------------------------------

// Prisma 7's native generator — emits ESM TypeScript into `output`, so there is
// no dependency on the legacy @prisma/client runtime shape.
generator client {
  provider     = "prisma-client"
  output       = "../generated/client"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

// Prisma 7 takes the connection URL from prisma.config.ts (CLI) and from the
// driver adapter passed to PrismaClient (runtime) — not from this block.
datasource db {
  provider = "sqlite"
}

/// One observed, timestamped piece of evidence. Append-only and never edited —
/// signals are the audit trail that justifies every inferred entry.
model Signal {
  id         String   @id @default(cuid())
  /// Stable dedupe key, e.g. git:<repo>:<sha>. Re-collecting is idempotent.
  sourceId   String   @unique
  kind       String
  at         DateTime
  /// Measured end of the work, when the source clocked it (agent harness turns).
  /// Null for trailing-edge signals like commits, where duration is inferred.
  until      DateTime?
  projectKey String?
  subject    String?
  /// JSON array of touched paths.
  pathsJson  String?
  /// Set once the signal has been folded into an entry, so re-running
  /// reconstruction does not double-count work already logged.
  consumedAt DateTime?
  /// OpenProject work package ref, set by attribution in slice 3 — before
  /// inference consumes the signal. Null until then.
  taskId     String?
  createdAt  DateTime @default(now())

  @@index([at])
  @@index([projectKey, at])
  @@index([consumedAt])
}

/// A running timer. At most one may be open per project, and that is now a
/// database constraint rather than a convention: the CLI, Claude Code's MCP
/// server and OpenCode's each run their own process against this file, so a
/// code-only check loses to a simultaneous start. Timers on different projects
/// run side by side — the person is on two engagements in one afternoon.
model Timer {
  id         String   @id @default(cuid())
  projectKey String
  activity   String?
  note       String?
  /// OpenProject work package id the running timer will log against ("136").
  /// Null when no task was chosen at start.
  taskId     String?
  startedAt  DateTime
  stoppedAt  DateTime?
  /// The project key while running, null once stopped — always in step with
  /// stoppedAt.
  ///
  /// This is how SQLite expresses "at most one open timer per project" without
  /// a partial index: NULLs are distinct in a unique index, so any number of
  /// stopped timers coexist while a second concurrent start on the same
  /// project hits the constraint and fails instead of creating a rival timer.
  /// A start on a *different* project carries a different key and coexists.
  openKey    String?  @unique

  @@index([stoppedAt])
}

/// A reviewable timesheet row. draft → approved → pushed, one direction only.
model Entry {
  id         String   @id @default(cuid())
  /// Local calendar day, YYYY-MM-DD.
  day        String
  person     String
  projectKey String
  minutes    Int
  activity   String
  /// JSON array of {startMin,endMin} clock ranges.
  rangesJson String
  description String?
  status     String   @default("draft")
  /// Why the tool believed this. Never written to the sheet.
  provenance String?
  /// JSON array of the signal sourceIds this entry was inferred from. Lets a
  /// dropped draft release its signals back into the pool instead of losing
  /// that time forever. Null for a manually logged entry.
  signalIdsJson String?
  /// Set on a successful push; the A1 range the row landed in.
  sheetRange String?
  pushedAt   DateTime?
  /// OpenProject work package id ("136") the minutes are logged against. A
  /// plain string on purpose: no relation, not every entry belongs to a task.
  taskId     String?
  /// Push lease. Held from just before the sheet append until the push
  /// resolves, so a second agent pushing the same approved entries at the same
  /// moment skips them instead of appending the row twice — the sheet is
  /// append-only and shared, so a duplicate there is someone else's problem to
  /// find. Cleared on success and on failure; a lease older than
  /// PUSH_LEASE_TTL_MS counts as abandoned by a crashed process.
  pushLeaseAt DateTime?
  /// Random token identifying the process holding the lease. Unique per
  /// attempt, which is what lets a claimer read back exactly what it won.
  pushLeaseBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([day, person])
  @@index([status])
  @@index([projectKey, day])
  @@index([taskId])
  @@index([pushLeaseBy])
}

/// A cached OpenProject work package. Reconciliation point between the two
/// ledgers: OpenProject's spentTime on one side, the local entries summed by
/// taskId on the other. Never the only copy — the sheet is the ledger of
/// record.
model Task {
  /// OpenProject work package id, e.g. "136".
  id            String   @id
  projectKey    String
  subject       String
  status        String?
  /// OpenProject's spentTime, cached. Null until the first sync.
  spentMinutes  Int?
  /// estimatedTime cached for display only — budgets are out of scope.
  estimatedMinutes Int?
  /// Last successful sync; null until the first one.
  syncedAt      DateTime?

  @@index([projectKey])
}

/// One push attempt, successful or not. Kept forever: this is the answer to
/// "did that row actually make it into the sheet, and when?"
model PushLog {
  id         String   @id @default(cuid())
  projectKey String
  sheetTab   String
  rowCount   Int
  minutes    Int
  ok         Boolean
  error      String?
  /// JSON array of the entry ids included.
  entryIds   String
  /// JSON array of {entryId, timeEntryId} — the OpenProject time entries this
  /// push created. Null when the push wrote none. The write-through is
  /// idempotent: a retried push skips entries whose OP time entry already
  /// landed, and this column is what makes that possible.
  openProjectTimeEntries String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
