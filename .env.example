# Your name, exactly as it appears in the sheet's Person column.
# The sheet already contains casing duplicates (Kristian/kristian) — match the
# spelling you want your rows grouped under in the pivot tables.
HOURS_PERSON=

# The shared Hours spreadsheet id (the long string in its URL).
# Named to match lp-internal-ai-v1's existing GOOGLE_SHEETS_HOURS_ID; either works.
HOURS_SHEET_ID=1IME_dMlV4uSTOk_U622ApQl6eFfPNMYneE_9zGpDNQE

# --- OAuth (recommended) ---
# A Desktop-app OAuth client in any Google Cloud project with the Sheets API
# enabled. `pnpm sheets:auth` opens a browser for one-time consent and stores
# the refresh token at GOOGLE_OAUTH_TOKEN_PATH (default ~/.config/hours/credentials.json).
# The consenting Google account must already be an Editor of the sheet.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_TOKEN_PATH=

# --- Service account (fallback) ---
# Base64-encoded service-account JSON with edit access to the sheet.
# Same value and encoding as lp-internal-ai-v1 uses. The service account's email
# must be shared into the spreadsheet as an Editor before a push can work.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Local store. Defaults to ./hours.db (SQLite) — set a postgres:// URL and
# switch the datasource provider in packages/db/prisma/schema.prisma to share
# lp-internal-ai-v1's database instead.
DATABASE_URL=

# Set to 1 to keep inferred work that happened outside the 9 AM–3 PM window.
HOURS_ALLOW_OUTSIDE=

# --- Harness collection (see docs/harnesses.md) ---
# Every source is read by default. Set one to 0 to skip it — a source that is
# quietly not collected produces a timesheet that looks complete and is not, so
# these are opt-out, and blank counts as unset rather than as off.
# HOURS_HARNESS_CLAUDE=      # Claude Code transcripts (~/.claude/projects)
# HOURS_HARNESS_OPENCODE=    # OpenCode storage (~/.local/share/opencode)
# HOURS_HARNESS_EDITORS=     # VS Code-family local history (VSCodium, Cursor, …)
# Longest a single agent turn may claim, in minutes. Bounds the case where a tool
# call sits on a permission prompt while you go to lunch. Default 120.
# HOURS_MAX_SPAN_MIN=
# OpenCode storage restored from another machine carries that machine's home
# directory in its absolute paths. Set to 0 to stop rewriting it onto this one.
# HOURS_OPENCODE_REMAP_HOME=

# --- OpenProject (task hours) ---
# The OpenProject instance hosting the engagement's tasks, e.g.
# https://projects.liftofflearning.tech. Read-only: the task-hours cache pulls
# work packages and logged time from here; nothing is ever written back.
# Env only — never put these in hours.config.json (secrets stay out of it).
OPENPROJECT_URL=
# API key (your avatar → Account settings → API access). Sent as Basic auth.
OPENPROJECT_API_KEY=
